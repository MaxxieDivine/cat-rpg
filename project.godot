; Engine configuration file.
; Hand-maintained: see CLAUDE.md "Milestone 0 checklist" for why each setting is here.

config_version=5

[application]

config/name="Cat RPG"
run/main_scene="res://scenes/hello.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")

[display]

window/size/viewport_width=390
window/size/viewport_height=844
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=6

[input_devices]

pointing/emulate_touch_from_mouse=false
pointing/emulate_mouse_from_touch=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
environment/defaults/default_clear_color=Color(0.6, 0.8, 0.55, 1)
